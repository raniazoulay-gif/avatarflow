# ===================== Accounts =====================
SOURCE_GMAIL_ACCOUNT=
TARGET_GMAIL_ACCOUNT=

# ===================== Gmail OAuth 2.0 (no passwords) =====================
# Get the refresh token once with: python scripts/get_refresh_token.py client_secret.json
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional Gmail Watch + Pub/Sub (polling fallback is always active)
# e.g. projects/my-project/topics/gmail-invoices
GMAIL_PUBSUB_TOPIC=
# Push subscription endpoint: https://<host>/gmail/push?token=<PUBSUB_VERIFICATION_TOKEN>
PUBSUB_VERIFICATION_TOKEN=
POLL_INTERVAL_SECONDS=60

# ===================== AI (Anthropic Claude API) =====================
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_DOC_CHARS=8000
AI_WEIGHT=0.70
RULE_WEIGHT=0.30

# ===================== Scheduling =====================
TIMEZONE=Asia/Jerusalem
DAILY_REPORT_TIME=18:00

# ===================== SAFETY SWITCHES =====================
# Forwarding happens ONLY when ALL THREE are set:
#   DRY_RUN=false  AND  AUTO_FORWARD_ENABLED=true  AND  PRODUCTION_CONFIRMATION=true
# The system NEVER changes these itself (also not after DRY_RUN_DAYS).
DRY_RUN=true
AUTO_FORWARD_ENABLED=false
PRODUCTION_CONFIRMATION=false
DRY_RUN_DAYS=7

# ===================== Thresholds =====================
INVOICE_AUTO_FORWARD_THRESHOLD=0.90
REVIEW_THRESHOLD=0.70

# ===================== Backfill =====================
BACKFILL_DAYS=0
BACKFILL_FORWARD_ENABLED=false

# ===================== Supplier whitelist (optional) =====================
SUPPLIER_WHITELIST_ENABLED=false
# comma separated: full addresses or @domain.com
SUPPLIER_WHITELIST=

# ===================== Processing =====================
MAX_ATTACHMENT_SIZE_MB=25
OCR_LANGUAGES=heb+eng
MAX_PROCESSING_ATTEMPTS=3
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=1

# ===================== Storage =====================
# SQLite by default; for PostgreSQL: postgresql+psycopg2://user:pass@host:5432/invoices
DATABASE_URL=sqlite:///data/invoices.db
REPORTS_DIR=reports_out
# Keep false: full document text is NOT stored by default (privacy)
STORE_DOCUMENT_TEXT=false

PORT=8080
LOG_LEVEL=INFO
