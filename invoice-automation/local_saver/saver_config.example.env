# ===== Invoice Saver - local configuration =====
# Copy this file to "saver_config.env" (same folder) and fill in the values.
# Keep saver_config.env ONLY on your computer - never share it or put it in OneDrive.

# Same three values you put in Railway:
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# The Gmail account the cloud service watches (safety check):
GMAIL_ACCOUNT=raniazoulay@gmail.com

# Folder where invoices are saved (a YYYY-MM sub-folder is created per month):
SAVE_DIR=C:\Users\Ran Azoulay\OneDrive - Matrix IT Ltd\Desktop\Desktop\Drive\RAN\Claude\SKILL\GOOD\Gmail Invoice Automation\חשבוניות

# Also save "Invoice/Review" (uncertain) emails into a "לבדיקה" sub-folder? true / false
SAVE_REVIEW=false
