# SafeDrive API configuration. Copy to .env and fill in. NEVER commit .env.
# Profiles: development | test | staging | production (NODE_ENV).
# Values marked [secret] must come from a secret manager in staging/production.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# --- Database / cache -------------------------------------------------------
DATABASE_URL=postgres://safedrive:safedrive@localhost:5432/safedrive_dev
DATABASE_POOL_MAX=20
# Optional. With Redis, realtime events fan out across several API instances.
REDIS_URL=

# --- Auth -------------------------------------------------------------------
# [secret] at least 32 random characters, e.g. from: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# The account registered with this email becomes a system admin.
BOOTSTRAP_ADMIN_EMAIL=

# --- HTTP -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
# true only behind a trusted reverse proxy / load balancer
TRUST_PROXY=false

# --- Demo mode (simulated data, always labelled is_demo) ---------------------
# Recommended false in production unless sales demos are needed.
DEMO_MODE_ENABLED=true

# --- Speed-limit providers (comma separated, tried in order) ----------------
# osm = OpenStreetMap Overpass (free, coverage varies; use a self-hosted Overpass in production)
# here / tomtom = commercial, need keys and a signed contract
SPEED_LIMIT_PROVIDERS=osm
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_MIN_INTERVAL_MS=1100
# [secret]
HERE_API_KEY=
# [secret]
TOMTOM_API_KEY=
SPEED_LIMIT_CACHE_TTL_DAYS=30
SPEED_LIMIT_NEGATIVE_TTL_HOURS=24
SPEED_LIMIT_LOOKUP_MIN_METERS=100
SPEED_LIMIT_LOOKUP_MIN_SECONDS=30
PROVIDER_HTTP_TIMEOUT_MS=4000

# --- Push notifications -----------------------------------------------------
# log = write to server log (dev) | expo = Expo push service | none
PUSH_PROVIDER=log
# [secret] optional, enables "enhanced push security" in Expo
EXPO_ACCESS_TOKEN=

# --- Maps / provider etiquette ----------------------------------------------
# Sent in the User-Agent of OSM/Overpass calls (required by their usage policy).
CONTACT_EMAIL=ops@example.com
# The public OSM tile server is for development only (tile usage policy).
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors

# --- Jobs / observability ---------------------------------------------------
OFFLINE_AFTER_SECONDS=90
AUTO_END_TRIP_AFTER_MINUTES=30
WORKERS_ENABLED=true
# [secret] required to read /metrics (Bearer token)
METRICS_TOKEN=

# --- docker-compose only ----------------------------------------------------
POSTGRES_PASSWORD=safedrive
