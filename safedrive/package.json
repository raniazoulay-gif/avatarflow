{
  "name": "safedrive",
  "private": true,
  "version": "0.1.0",
  "description": "SafeDrive - family driving safety platform",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @safedrive/core && npm run build -w @safedrive/api && npm run build -w @safedrive/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test -w @safedrive/core",
    "test:api": "npm run test -w @safedrive/api",
    "db:migrate": "npm run migrate -w @safedrive/api",
    "dev:api": "npm run dev -w @safedrive/api",
    "dev:web": "npm run dev -w @safedrive/web",
    "demo": "npm run demo -w @safedrive/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
